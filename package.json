{
  "name": "solana-payments",
  "version": "0.4.0",
  "description": "Developer-friendly Node.js SDK for SPL-token balances, transfers, and payment verification on Solana.",
  "keywords": [
    "payments",
    "sdk",
    "solana",
    "solana-payments",
    "spl-token",
    "tanstack-intent",
    "token",
    "typescript"
  ],
  "homepage": "https://github.com/alexasomba/solana-payments#readme",
  "bugs": {
    "url": "https://github.com/alexasomba/solana-payments/issues"
  },
  "license": "MIT",
  "author": "alexasomba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexasomba/solana-payments.git"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "test:integration": "vp test run test/litesvm.integration.test.ts --testTimeout 120000",
    "test:live": "pnpm run test:integration",
    "smoke:mainnet": "pnpm run build && node examples/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:package": "publint run --strict",
    "lint:types": "attw --profile esm-only --pack .",
    "check": "vp check",
    "clean": "rm -rf dist coverage",
    "prepack": "vp pack",
    "prepare": "skills-npm"
  },
  "dependencies": {
    "@solana-program/memo": "0.13.0",
    "@solana-program/token": "0.16.0",
    "@solana/kit": "8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@solana-program/system": "0.14.0",
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^24.13.3",
    "litesvm": "^1.3.0",
    "publint": "^0.3.24",
    "skills-npm": "^1.2.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
